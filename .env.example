# AI Provider: anthropic, gemini, groq, openrouter, ollama
JOB_AGENT_AI_PROVIDER=gemini

# API Keys (set the one for your chosen provider)
# Google Gemini (FREE) — get key at https://aistudio.google.com/apikey
JOB_AGENT_GEMINI_API_KEY=

# Groq (FREE) — get key at https://console.groq.com
JOB_AGENT_GROQ_API_KEY=

# OpenRouter — get key at https://openrouter.ai/keys
JOB_AGENT_OPENROUTER_API_KEY=

# Anthropic Claude (PAID) — get key at https://console.anthropic.com
JOB_AGENT_ANTHROPIC_API_KEY=

# Ollama — no key needed, runs locally. Install: https://ollama.com

# Flask / dashboard
JOB_AGENT_FLASK_SECRET_KEY=change-me-to-a-random-string
# Leave empty to auto-generate ~/.job-agent/dashboard_token on first start.
# JOB_AGENT_DASHBOARD__AUTH_TOKEN=
# JOB_AGENT_DASHBOARD__AUTH_ENABLED=true
# JOB_AGENT_DASHBOARD__DEBUG=false

# Safety: dry-run is on by default; submissions still need approval.
# JOB_AGENT_AGENT__DRY_RUN=true
# JOB_AGENT_AGENT__REQUIRE_APPROVAL_FOR_ALL=true
# JOB_AGENT_AGENT__MAX_RUN_MINUTES=25

# Grounded documents (edit the Markdown templates instead of these)
# JOB_AGENT_CONTENT__MODE=grounded
# JOB_AGENT_CONTENT__CANDIDATE_PROFILE=config/templates/candidate_profile.md

# Spreadsheet approval surface (csv works with no extra dependencies)
# JOB_AGENT_SHEETS__BACKEND=csv
# JOB_AGENT_SHEETS__DIRECTORY=~/.job-agent/sheets

# Fast feeds + AI-training gigs
# JOB_AGENT_FEEDS__ENABLED=true
# JOB_AGENT_GIGS__ENABLED=true
# JOB_AGENT_GIGS__MIN_HOURLY_RATE=20

# Ego Lite (macOS build verified; leave binary empty to auto-resolve)
# JOB_AGENT_EGO__ENABLED=false
# JOB_AGENT_EGO__REQUIRE_HUMAN_SUBMIT=true

# Database (defaults to ~/.job-agent/agent.db)
# JOB_AGENT_DATABASE_URL=sqlite:///path/to/agent.db

# Email notifications (optional)
JOB_AGENT_SMTP_HOST=smtp.gmail.com
JOB_AGENT_SMTP_PORT=587
JOB_AGENT_SMTP_USER=
JOB_AGENT_SMTP_PASSWORD=
JOB_AGENT_NOTIFICATION_EMAIL=

# Webhook notifications (optional)
JOB_AGENT_SLACK_WEBHOOK_URL=
JOB_AGENT_DISCORD_WEBHOOK_URL=

# Proxy (optional)
# JOB_AGENT_PROXY_URL=socks5://user:pass@host:port
